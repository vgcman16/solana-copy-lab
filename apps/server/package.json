{
  "name": "@copylab/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts src/backup-cli.ts src/backup-retention-cli.ts src/restore-cli.ts src/stock-paper-capital-cli.ts --format esm --clean --sourcemap --external better-sqlite3 --external @primno/dpapi",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@copylab/core": "workspace:*",
    "@copylab/providers": "workspace:*",
    "@copylab/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^9.0.0",
    "@primno/dpapi": "^2.0.1",
    "@solana/web3.js": "^1.98.4",
    "better-sqlite3": "^12.11.1",
    "bs58": "^6.0.0",
    "fastify": "^5.10.0",
    "ws": "^8.21.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
